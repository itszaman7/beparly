DJANGO_DEBUG=1
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
API_ALLOWED_ORIGINS=http://localhost:8081,http://localhost:8082,http://127.0.0.1:8081,http://127.0.0.1:8082,http://localhost:19006
POSTGRES_DB=beparly
POSTGRES_USER=beparly
POSTGRES_PASSWORD=replace-with-a-unique-local-password
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433
# Production product images (leave unset for local development media storage):
# PRODUCT_STORAGE_BUCKET=your-private-bucket
# PRODUCT_STORAGE_REGION=ap-south-1
# PRODUCT_STORAGE_ENDPOINT=
# PRODUCT_CDN_DOMAIN=images.example.com
# PRODUCT_CDN_KEY_ID=replace-with-cloudfront-key-id
# PRODUCT_CDN_PRIVATE_KEY_PATH=/run/secrets/product-cdn-private-key.pem
# Private supporting documents (required in production; do not expose through a CDN):
# ATTACHMENT_STORAGE_BUCKET=your-private-documents-bucket
# Production only, after HTTPS reverse proxy is correctly configured:
# DJANGO_DEBUG=0
# DJANGO_ALLOWED_HOSTS=api.example.com
# API_ALLOWED_ORIGINS=https://pos.example.com
# DJANGO_TRUST_PROXY_SSL_HEADER=1
# DJANGO_HSTS_SECONDS=3600
# Increase HSTS only after validating HTTPS for the exact host; subdomains and preload are opt-in.
