{
  "expo": {
    "name": "GotiBooks",
    "slug": "Beparly",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/android-chrome-512x512.png",
    "scheme": "beparly",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/android-chrome-512x512.png"
    },
    "android": {
      "package": "com.beparly.app",
      "adaptiveIcon": {
        "backgroundColor": "#00B7AC",
        "foregroundImage": "./assets/images/android-chrome-512x512.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA"
      ]
    },
    "web": {
      "output": "single",
      "name": "GotiBooks",
      "shortName": "GotiBooks",
      "favicon": "./assets/images/favicon-32x32.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "asyncRoutes": {
            "web": false
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#00B7AC",
          "image": "./assets/images/apple-touch-icon.png",
          "imageWidth": 180
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow GotiBooks to scan product barcodes",
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": true
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": false
        }
      },
      "eas": {
        "projectId": "280cd3c6-f706-4537-a471-96baf82eff3e"
      }
    }
  }
}
